# Maintainer: Hodai
pkgname=hodai-bin
pkgver={{version}}
pkgrel={{pkgrel}}
pkgdesc="Free, open source music player. No account needed"
arch=(x86_64 aarch64)
url="https://github.com/andikachr/hodai"
license=('AGPL-3.0-or-later')
# libvlc + plugins for playback (FFmpeg demux/decode, GnuTLS for HTTPS streams, PulseAudio/PipeWire output),
# WebKitGTK 4.1 for the webview, and the X11/GL/ALSA libraries the AWT/Skiko natives link
depends=(
  'libvlc' 'vlc-plugins-base' 'vlc-plugin-ffmpeg' 'vlc-plugin-gnutls' 'vlc-plugin-pulse'
  'webkit2gtk-4.1' 'gtk3' 'glib2' 'dbus' 'alsa-lib' 'libglvnd' 'fontconfig' 'freetype2'
  'libx11' 'libxext' 'libxi' 'libxrender' 'libxtst' 'zlib'
)
provides=('hodai')
conflicts=('hodai')
options=('!strip' '!debug')
source_x86_64=("https://github.com/andikachr/hodai/releases/download/v${pkgver}/hodai-linux-${pkgver}-x86_64.tar.xz")
source_aarch64=("https://github.com/andikachr/hodai/releases/download/v${pkgver}/hodai-linux-${pkgver}-aarch64.tar.xz")
sha256sums_x86_64=('{{artifacts.linuxX86_64.sha256}}')
sha256sums_aarch64=('{{artifacts.linuxAarch64.sha256}}')

package() {
  cd "hodai-linux-${pkgver}-${CARCH}"

  install -dm755 "${pkgdir}/opt" "${pkgdir}/usr/bin" "${pkgdir}/usr/share"
  cp -a app "${pkgdir}/opt/hodai"
  cp -a share/. "${pkgdir}/usr/share/"
  # The executable inside the tarball is still named "spotube" (build output name);
  # the command users run is "hodai".
  ln -s /opt/hodai/spotube "${pkgdir}/usr/bin/hodai"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
